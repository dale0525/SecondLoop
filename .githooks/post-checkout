#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "${repo_root}" ]] || exit 0
cd "${repo_root}"

old_ref="${1:-}"
new_ref="${2:-}"
checkout_type="${3:-}"

if [[ "${checkout_type}" != "1" ]]; then
  exit 0
fi

if [[ -z "${old_ref}" || -z "${new_ref}" ]]; then
  exit 0
fi

while IFS= read -r path; do
  case "${path}" in
    slang.yaml | lib/i18n/*.i18n.json)
      bash scripts/run_i18n_refresh.sh
      exit 0
      ;;
  esac
done < <(git diff --name-only "${old_ref}" "${new_ref}" --)
