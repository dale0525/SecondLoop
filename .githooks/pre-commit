#!/usr/bin/env bash
set -euo pipefail

check_mode=0
i18n_generated_now=0
scope_flutter=0
scope_rust=0
ci_mode=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --check) check_mode=1 ;;
    --flutter) scope_flutter=1 ;;
    --rust) scope_rust=1 ;;
    --ci) ci_mode=1 ;;
    -h | --help)
      cat <<'EOF'
Usage: .githooks/pre-commit [--check] [--flutter] [--rust] [--ci]

Default (no flags): git pre-commit hook mode (format staged files + analyze + targeted Flutter tests when possible, plus rustfmt).

--check    CI-friendly mode: verify formatting/analyze without modifying files.
--flutter  Limit --check to Dart format + flutter analyze.
--rust     Limit --check to rustfmt.
--ci       In --check mode, also run full tests/clippy to match CI and pre-push.
EOF
      exit 0
      ;;
    *)
      echo "pre-commit: Unknown argument: $1" >&2
      exit 1
      ;;
  esac
  shift
 done

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${repo_root}" ]]; then
  exit 0
fi

cd "${repo_root}"

if (( check_mode )); then
  export SECONDLOOP_PRECOMMIT_ALLOW_WORKTREE_WRITES=0
fi

source "${repo_root}/scripts/pre_commit_common.sh"

if (( check_mode )); then
  source "${repo_root}/scripts/pre_commit_check_mode.sh"
else
  source "${repo_root}/scripts/pre_commit_commit_mode.sh"
fi
