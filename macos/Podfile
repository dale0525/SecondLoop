platform :osx, '10.15'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

# Flutter 3.22's podhelper splits xcconfig lines on every "=", which makes
# base64-padded DART_DEFINES noisy during macOS pod install/build.
def flutter_parse_xcconfig_file(file)
  file_abs_path = File.expand_path(file)
  return {} unless File.exist?(file_abs_path)

  entries = {}
  skip_line_start_symbols = ['#', '/']
  File.foreach(file_abs_path) do |line|
    next if line.strip.empty?
    next if skip_line_start_symbols.any? { |symbol| line =~ /^\s*#{symbol}/ }

    key_value_pair = line.split('=', 2)
    if key_value_pair.length == 2
      entries[key_value_pair[0].strip] = key_value_pair[1].strip
    else
      puts "Invalid key/value pair: #{line}"
    end
  end
  entries
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)

    if target.name == 'audio_session'
      target.build_configurations.each do |config|
        config.build_settings['GCC_WARN_UNUSED_VALUE'] = 'NO'
      end
    end

    if target.name == 'sqlite3'
      target.build_configurations.each do |config|
        # sqlite3 is vendored third-party C code; keep app builds focused on
        # actionable warnings from our own code and plugin integration.
        config.build_settings['GCC_WARN_64_TO_32_BIT_CONVERSION'] = 'NO'
        config.build_settings['CLANG_WARN_AMBIGUOUS_MACRO'] = 'NO'
        other_cflags = config.build_settings['OTHER_CFLAGS']
        cflags = other_cflags.is_a?(Array) ? other_cflags.dup : other_cflags.to_s.split(/\s+/)
        cflags << '$(inherited)' if cflags.empty?
        [
          '-Wno-ambiguous-macro',
          '-Wno-shorten-64-to-32',
          '-Wno-comma',
          '-Wno-unreachable-code',
        ].each do |flag|
          cflags << flag unless cflags.include?(flag)
        end
        config.build_settings['OTHER_CFLAGS'] = cflags
      end
    end
  end

  hotkey_file = File.join(
    installer.sandbox.root.to_s,
    'HotKey',
    'Sources',
    'HotKey',
    'NSEventModifierFlags+HotKey.swift',
  )
  if File.exist?(hotkey_file)
    begin
      contents = File.read(hotkey_file)
      updated = contents.gsub(
        'extension NSEvent.ModifierFlags: CustomStringConvertible {',
        'extension NSEvent.ModifierFlags: @retroactive CustomStringConvertible {',
      )
      if updated != contents
        begin
          File.chmod(0o644, hotkey_file)
        rescue StandardError
          # Best-effort: keep going even if chmod fails.
        end
        File.write(hotkey_file, updated)
      end
    rescue StandardError
      # Best-effort: never fail pod install due to a warning-only patch.
    end
  end

end
